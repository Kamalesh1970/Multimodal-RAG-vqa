APP_NAME="Multimodal RAG VQA"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_PATH=data/app.db

# Ingestion configuration
MAX_UPLOAD_MB=20

# Safe placeholder for future phases. DO NOT enter actual API key here.
GEMINI_API_KEY=

# Phase 3 Embeddings configurations
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
IMAGE_EMBEDDING_MODEL=ViT-B-32
IMAGE_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
EMBEDDING_DEVICE=auto
VECTOR_INDEX_DIR=data/indexes

# Phase 4 Retrieval configurations
RETRIEVAL_TOP_K=3
TEXT_RETRIEVAL_WEIGHT=0.65
IMAGE_RETRIEVAL_WEIGHT=0.35
RETRIEVAL_MIN_SCORE=0.0

# Phase 5 Gemini configurations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30.0
GEMINI_MAX_RETRIES=2

# Phase 5 VLM Backend configuration
VLM_PROVIDER=gemini # Change to 'openai' to use OpenAI instead

# OpenAI API Key & Settings
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30.0
OPENAI_MAX_RETRIES=2

# Phase 5 Cost & Token Budget Configurations
GENERATION_TOP_K=2
VLM_MAX_OUTPUT_TOKENS=512
MAX_OCR_CONTEXT_CHARS=4000
MAX_VLM_IMAGES=2
MAX_VLM_CALLS_PER_REQUEST=1
MAX_IMAGE_DIMENSION=1024
ENABLE_LIVE_VLM_TESTS=false

# Phase 8 Performance & Detail Settings
VLM_MAX_PAGES=2
VLM_SCORE_GAP_THRESHOLD=0.25
VLM_TEXT_DETAIL=low
VLM_VISUAL_DETAIL=high
VLM_TEXT_MAX_IMAGES=1
VLM_VISUAL_MAX_IMAGES=1
VLM_CROP_EVIDENCE=false
PDF_RENDER_DPI=150

# Phase 9 Firebase/Firestore configurations
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=


